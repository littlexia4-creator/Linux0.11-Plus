###############################################################
# bochsrc.bxrc file for Tinix.
###############################################################

# how much memory the emulated machine will have
megs: 32

# filename of ROM images
romimage: file="E:\Program Files\Bochs-2.8\BIOS-bochs-latest"
vgaromimage: file="E:\Program Files\Bochs-2.8\VGABIOS-elpin-2.40"

# what disk images will be used 
floppya: 1_44=boot.img, status=inserted
floppyb: 1_44=rootimage-0.11.img, status=inserted
ata0-master: type=disk, path="hdc-0.11.img", mode=flat, cylinders=121, heads=16, spt=63

# choose the boot disk.
boot: a

# where do we send log messages?
log: bochsout.txt

# disable the mouse, since Tinix is text only
mouse: enabled=0

# enable key mapping, using US layout as default.
keyboard: keymap="E:\Program Files\Bochs-2.7\keymaps\x11-pc-us.map"
